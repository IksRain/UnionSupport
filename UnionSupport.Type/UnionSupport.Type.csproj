<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>UnionSupport.Type</RootNamespace>
        <PackageId>UnionSupport.Type</PackageId>
        <Description>Pre-generated union types (Product/Unmanaged/ObjectErasure) for 1–17 type parameters. No source generator needed.</Description>
        <DevelopmentDependency>true</DevelopmentDependency>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\UnionSupport.Core\UnionSupport.Core.csproj" />
        <ProjectReference Include="..\UnionSupport.Generator.Product\UnionSupport.Generator.Product.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\UnionSupport.Generator.Unmanaged\UnionSupport.Generator.Unmanaged.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\UnionSupport.Generator.Erasure\UnionSupport.Generator.Erasure.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
